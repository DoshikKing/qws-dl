{
  "name": "qws-dl",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "setup:codecs": "bash scripts/install-audio-codecs.sh",
    "setup:orpheus": "bash scripts/install-orpheus.sh",
    "diagnose:qobuz": "node --env-file-if-exists=.env scripts/diagnose-qobuz.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/http.smoke.mjs tests/security.http.mjs tests/uploads.http.mjs tests/album-tracks.http.mjs tests/retention.http.mjs tests/news.http.mjs tests/subscription.http.mjs tests/statistics.http.mjs tests/shares.http.mjs",
    "test:python": ".runtime/venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "typecheck": "nuxt typecheck",
    "release:prepare": "node scripts/release.mjs"
  },
  "dependencies": {
    "nuxt": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "version": "1.4.0"
}
