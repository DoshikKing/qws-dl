# The administrator is created automatically. Credentials are synchronized on restart.
# Login: 3-32 ASCII letters/digits, dot, underscore or hyphen. Password: 10-256 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Lifetime number of registrations through each ordinary user's invite code (0-10000).
# The administrator can invite unlimited users. Changes apply after restart.
USER_INVITE_LIMIT=1
# In web mode, sign in via Settings → Qobuz in the app. Enter credentials on Qobuz's site.
# The app saves the returned session privately in DATA_DIR; no manual token is needed.
# The following email/password fields are for legacy API compatibility only.
# Qobuz's current web client no longer supports direct user/login password auth.
# A Qobuz subscription with download access is required.
QOBUZ_USERNAME=
QOBUZ_PASSWORD=
# web (default): browser OAuth login from administrator settings.
# token: reuse your own web session instead of an email/password login.
# mobile: legacy module, requires your matching mobile app_id/app_secret pair.
QOBUZ_AUTH_MODE=web
# Only for QOBUZ_AUTH_MODE=token. Keep these credentials private.
QOBUZ_USER_ID=
QOBUZ_AUTH_TOKEN=
# Only used with QOBUZ_AUTH_MODE=mobile. Leave empty for web login.
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=
# hifi: up to 24-bit/192 kHz; lossless: 16-bit/44.1 kHz; high: MP3 320.
DOWNLOAD_QUALITY=hifi
# Default file/archive lifetime after a job finishes. Integer hours, 1–24.
# The user can select a different lifetime for each new download.
DOWNLOAD_RETENTION_HOURS=24
# Local paths, relative to the project root. Compose uses container paths instead.
ORPHEUS_DIR=.runtime/orpheusdl
PYTHON_BIN=.runtime/venv/bin/python
DATA_DIR=data
DOWNLOAD_DIR=downloads
# Maximum runtime of one job (seconds).
JOB_TIMEOUT_SECONDS=7200
# Docker: bind to localhost by default. Use a TLS reverse proxy for remote access.
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Application base path: / for root, /dl/ for a subpath. /dl also works.
# Runtime setting: after editing, recreate the container (no rebuild needed).
NUXT_APP_BASE_URL=/
